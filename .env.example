# Required for production; do not use NEXT_PUBLIC_ for secrets.
ACCESS_PASSPHRASE=
SESSION_SECRET=
# demo (default) or an absolute/relative private content JSON path
CONTENT_CONFIG_PATH=content/content-config.demo.json
# Optional Vercel/private deployment alternative. Keep JSON server-only.
PRIVATE_CONTENT_CONFIG=
# `local` is the default; `remote` proxies an authenticated HTTPS media service.
MEDIA_PROVIDER=local
PRIVATE_MEDIA_BASE_URL=
PRIVATE_MEDIA_TOKEN=
# Set to true only for an explicitly approved pre-content private preview.
ALLOW_INCOMPLETE_PRIVATE_CONTENT=false
# Optional: comma-separated trusted proxy/IP headers are intentionally not used locally.
