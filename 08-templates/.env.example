# Server-only. Never prefix secrets with NEXT_PUBLIC_.
ACCESS_SECRET_HASH=replace-with-strong-hash
SESSION_SIGNING_SECRET=replace-with-long-random-secret
BIRTHDAY_AT=2026-08-08T00:00:00+05:30
APP_TIMEZONE=Asia/Kolkata
CONTENT_CONFIG_PATH=/secure/path/content-config.json
MEDIA_DELIVERY_MODE=managed-protection
PRIVATE_MEDIA_ORIGIN=
PRIVATE_MEDIA_SIGNING_KEY=
NEXT_PUBLIC_SITE_ORIGIN=https://example.invalid
NEXT_PUBLIC_ENABLE_MEMORY_JAR=false
NEXT_PUBLIC_ENABLE_MICROPHONE_CANDLE=false
NEXT_PUBLIC_ENABLE_SHAKE_GIFT=false
